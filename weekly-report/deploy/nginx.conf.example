# Пример виртуального хоста nginx для svod.sigirgroup.tech (или любого другого
# внутреннего поддомена) — проксирует всё напрямую на Node-процесс, отдельной
# сборки клиента нет (сервер сам рендерит HTML).
#
# Скопируйте в /etc/nginx/sites-available/weekly-report, поправьте server_name,
# затем: ln -s .../sites-available/weekly-report /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name svod.sigirgroup.tech;  # замените на реальный поддомен

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS (certbot/Let's Encrypt или внутренний CA — как уже настроено для других
# поддоменов sigirgroup.tech) добавить тем же способом, что и для uat.sigirgroup.tech.
