# Порт, на котором слушает процесс (nginx проксирует сюда)
PORT=4100

# Путь к файлу данных (по умолчанию ./data.json рядом с процессом — на сервере
# стоит вынести в постоянную директорию, например /opt/weekly-report/data.json,
# чтобы деплой/пересборка не задевали данные)
DATA_PATH=/opt/weekly-report/data.json

# Базовый URL — только для красивого вывода ссылок скриптом seed, на работу
# сервера не влияет
BASE_URL=https://svod.sigirgroup.tech
